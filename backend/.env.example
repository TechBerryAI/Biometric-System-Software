APP_NAME=Biometric Attendance API
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL — create database first (see scripts/setup_local_database.sql)
# Preferred: split fields (app auto-builds DATABASE_URL at runtime)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biometric_db
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
# Set to disable when the server (or a proxy/port-forward in front of it) drops TLS negotiation;
# scripts/check_services.py tells you when this is needed.
# DB_SSLMODE=disable
# Fail fast instead of hanging when the database host is down (seconds).
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_POOL_TIMEOUT_SECONDS=15
#
# Optional override (takes precedence over DB_* if set):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Encode special chars in PASSWORD (e.g. @ -> %40, # -> %23)

# Redis — required for Celery (device polling) and device locks
REDIS_URL=redis://localhost:6379/0

# Frontend origins. Include the VM LAN URL used in the browser (example: http://192.168.1.60:5173).
# CORS_ALLOW_PRIVATE_NETWORK_ORIGINS=true already allows 192.168.x / 10.x / 172.16-31.x.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.60:5173,http://192.168.1.60
CORS_ALLOW_PRIVATE_NETWORK_ORIGINS=true

# ZKTeco / ESSL — connection IP, port, and timezone are managed in the Settings UI.
# Optional bootstrap defaults only for first-run seed when no device row exists yet:
# ZK_DEVICE_IP=192.168.1.200
# ZK_DEVICE_PORT=4370
TIMEZONE=Asia/Kolkata
ZK_DEVICE_PASSWORD=0
# Increase if the terminal is slow or pulls a very large log buffer
ZK_DEVICE_TIMEOUT_SECONDS=120
ZK_DEVICE_ID=main-entrance
ZK_FORCE_UDP=false
ZK_OMIT_PING=false

# Celery polls the device when true (needs `celery worker` + `celery beat`, or `npm run start:vm`)
DEVICE_AUTO_SYNC_ENABLED=true
# How often auto-sync pulls punches (seconds). Default 120.
DEVICE_POLL_INTERVAL_SECONDS=120
# Rewrite the terminal wall clock to device timezone when |drift| exceeds the threshold.
DEVICE_AUTO_SYNC_TIME=true
DEVICE_CLOCK_DRIFT_SECONDS=120

# Auth / RBAC
AUTH_ENABLED=true
# Local/dev must be false — CSRF cookie is only set after login, so true blocks /auth/login (403).
# Set true in production only when a pre-login CSRF cookie seed is in place.
CSRF_ENABLED=false
AUTH_COOKIE_ENABLED=true
# Optional first-install bootstrap only
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# GOD-mode operator (not stored in the users table; same /auth/login form)
AUTH_OPERATOR_EMAIL=
AUTH_OPERATOR_PASSWORD=
# Optional; preserve existing user_uuid when migrating operator out of the DB
# AUTH_OPERATOR_UUID=usr_operator_root01
JWT_SECRET_KEY=replace-this-in-production

# Forgot-password email (leave SMTP_HOST empty to skip sending; the UI still returns success)
# FRONTEND_URL must be the URL people open in the browser (used in reset links).
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional AI summaries (aggregate attendance data only)
XAI_API_KEY=
