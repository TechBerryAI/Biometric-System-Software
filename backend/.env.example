APP_NAME=Biometric Attendance API
DEBUG=false
LOG_LEVEL=INFO

# SQLAlchemy (use postgresql+psycopg for psycopg3)
# Default host ports match docker-compose.yml (avoids conflict with local Postgres/Redis on 5432/6379)
DATABASE_URL=postgresql+psycopg://biometric:biometric@localhost:5433/biometric

REDIS_URL=redis://localhost:6380/0

# ZKTeco / ESSL — READ ONLY: only get_users() and get_attendance(); never clear logs or edit users
ZK_DEVICE_IP=192.168.1.200
ZK_DEVICE_PORT=4370
ZK_DEVICE_PASSWORD=0
ZK_DEVICE_TIMEOUT_SECONDS=30
ZK_DEVICE_ID=main-entrance
ZK_FORCE_UDP=false
ZK_OMIT_PING=false

# Local calendar for shifts and daily summaries (IANA)
TIMEZONE=UTC

# Celery Beat interval for attendance polling (seconds); default 120 = 2 minutes
DEVICE_POLL_INTERVAL_SECONDS=120
