APP_NAME=Biometric Attendance API
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://frontend:5173
CORS_ALLOW_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):\d+$
CORS_ALLOW_PRIVATE_NETWORK_ORIGINS=true

# PostgreSQL — create database first (see scripts/setup_local_database.sql)
# Option A (single URL):
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#   Encode special chars in PASSWORD (e.g. @ -> %40, # -> %23)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/biometric_db
#
# Option B (split fields; app will auto-build DATABASE_URL at runtime):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=biometric_db
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD
# DB_SSLMODE=disable

# Redis — only required for Celery (device polling). Install Redis locally or skip START_CELERY.
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=biometric

# ZKTeco / ESSL
ZK_DEVICE_IP=192.168.1.200
ZK_DEVICE_PORT=4370
ZK_DEVICE_PASSWORD=0
# Increase if the terminal is slow or pulls a very large log buffer (device + HTTP calls need time).
ZK_DEVICE_TIMEOUT_SECONDS=120
ZK_DEVICE_ID=main-entrance
ZK_FORCE_UDP=false
ZK_OMIT_PING=false

TIMEZONE=Asia/Kolkata
DEVICE_POLL_INTERVAL_SECONDS=120
DEVICE_SYNC_OVERLAP_MINUTES=15
# For production after outages, consider 60–120 to reduce missed punches during incremental sync.
DUPLICATE_PUNCH_WINDOW_SECONDS=30
ATTENDANCE_API_DEFAULT_LIMIT=1000
ATTENDANCE_API_MAX_LIMIT=5000

# After each sync: rebuild AttendanceSession rows for this many trailing days (local TIMEZONE).
SESSION_REBUILD_LOOKBACK_DAYS=14

DEFAULT_SHIFT_START=09:30:00

# xAI Grok — optional AI summaries (aggregate attendance data only).
# Prefer fast structured model variants in production.
XAI_API_KEY=
XAI_MODEL=grok-code-fast-1
XAI_BASE_URL=https://api.x.ai/v1
AI_TIMEOUT_SECONDS=25
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.3
AI_CACHE_TTL=300
AI_RETRY_ATTEMPTS=2
AI_CIRCUIT_BREAKER_FAILURES=4
AI_CIRCUIT_BREAKER_RESET_SECONDS=90
AI_RATE_LIMIT_PER_MINUTE=30
AI_DAILY_QUOTA=500

# Auth / RBAC
AUTH_ENABLED=true
JWT_SECRET_KEY=replace-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_ATTEMPT_MAX=5
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Device command queue & reconciliation
COMMAND_QUEUE_BATCH_SIZE=25
COMMAND_MAX_RETRIES=5
COMMAND_RETRY_BASE_SECONDS=30
COMMAND_RETRY_MAX_SECONDS=900
COMMAND_STALE_MINUTES=15
COMMAND_HEARTBEAT_SECONDS=10
COMMAND_LOCK_BLOCKING_SECONDS=1
COMMAND_COOLDOWN_MS=250
COMMAND_MAX_RECOVER_VERIFICATION_LOOKBACK=3
RECONCILIATION_INTERVAL_SECONDS=300
SNAPSHOT_INTERVAL_SECONDS=900
SNAPSHOT_RETENTION_DAYS=30
COMMAND_HISTORY_RETENTION_DAYS=90
RECONCILIATION_RETENTION_DAYS=180
METRICS_RETENTION_DAYS=90
ALLOW_DEVICE_UID_REWRITE=false
ALLOW_DEVICE_PRIVILEGE_UPDATE=false
ALLOW_DEVICE_CARD_REWRITE=false
ALLOW_DEVICE_ADMIN_OVERRIDE=false
DEVICE_READ_ONLY=false
