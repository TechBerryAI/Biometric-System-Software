{
  "name": "biometric-system-software",
  "private": true,
  "description": "Biometric attendance — `make start` locally, `make start-vm` on the VM, `make test` for the suite.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start:vm": "node scripts/start-vm.js",
    "dev": "npm run dev -w attendance-frontend",
    "build": "npm run build -w attendance-frontend",
    "test": "npm run test -w attendance-frontend",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  }
}
